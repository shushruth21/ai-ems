// ── _base.prisma
// AI EMS — Prisma schema (multi-file). Conventions:
//  • every tenant table has organizationId and a composite index starting with it
//  • money Decimal(14,2), quantity Decimal(14,3), rates/percent Decimal(7,4)
//  • optimistic locking via `version`, soft delete via `archivedAt`
//  • tables and columns are snake_case in Postgres

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── auth.prisma
// ─── Authentication: security activity + rate limiting ──────────────────
// Identity itself lives in Supabase Auth (auth.users); Profile mirrors it.

enum AuthEventType {
  SIGN_IN_SUCCEEDED
  SIGN_IN_FAILED
  SIGN_UP
  MAGIC_LINK_REQUESTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  OAUTH_STARTED
  OAUTH_SUCCEEDED
  MFA_ENROLLED
  MFA_VERIFIED
  MFA_FAILED
  MFA_REMOVED
  SIGNED_OUT
  SIGNED_OUT_EVERYWHERE
  RATE_LIMITED
}

/// Append-only security log, not tenant-scoped (auth happens before an org is chosen).
/// Emails are stored only as an HMAC (`identityHash`), never in clear text.
model AuthEvent {
  id           BigInt        @id @default(autoincrement())
  profileId    String?       @map("profile_id") @db.Uuid
  identityHash String?       @map("identity_hash")
  type         AuthEventType
  ip           String?
  userAgent    String?       @map("user_agent")
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([profileId, createdAt(sort: Desc)])
  @@index([identityHash, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("auth_events")
}

/// Fixed-window counters shared by all app instances. Written with a single
/// atomic upsert; expired rows are purged opportunistically.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ── catalog.prisma
// ─── Catalog & configurator ──────────────────────────────────────────────

model ProductCategory {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  parentId       String? @map("parent_id")
  code           String
  name           String
  sortOrder      Int     @default(0) @map("sort_order")
  active         Boolean @default(true)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     ProductCategory[] @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, code])
  @@map("product_categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

model Product {
  id             String        @id @default(cuid(2))
  organizationId String        @map("organization_id")
  categoryId     String        @map("category_id")
  sku            String
  name           String
  description    String?
  status         ProductStatus @default(DRAFT)
  isConfigurable Boolean       @default(false) @map("is_configurable")
  basePrice      Decimal       @map("base_price") @db.Decimal(14, 2)
  taxRatePct     Decimal       @default(0) @map("tax_rate_pct") @db.Decimal(7, 4)
  leadTimeDays   Int           @default(0) @map("lead_time_days")
  imagePath      String?       @map("image_path")
  itemId         String?       @unique @map("item_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  version        Int           @default(0)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  item         Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  optionGroups OptionGroup[]
  priceRules   PriceRule[]
  boms         BillOfMaterials[]
  quoteLines   QuoteLine[]
  orderLines   SalesOrderLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, categoryId, status])
  @@map("products")
}

enum OptionInput {
  SELECT
  MULTI_SELECT
  NUMBER
  TEXT
  BOOLEAN
}

model OptionGroup {
  id             String      @id @default(cuid(2))
  organizationId String      @map("organization_id")
  productId      String      @map("product_id")
  code           String
  label          String
  input          OptionInput @default(SELECT)
  required       Boolean     @default(false)
  minValue       Decimal?    @map("min_value") @db.Decimal(14, 3)
  maxValue       Decimal?    @map("max_value") @db.Decimal(14, 3)
  sortOrder      Int         @default(0) @map("sort_order")
  /// Visibility rule (JSON-logic), e.g. show only when another option has a value.
  visibleWhen    Json?       @map("visible_when")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options      ProductOption[]

  @@unique([productId, code])
  @@index([organizationId])
  @@map("option_groups")
}

model ProductOption {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  groupId        String  @map("group_id")
  code           String
  label          String
  priceDelta     Decimal @default(0) @map("price_delta") @db.Decimal(14, 2)
  pricePctDelta  Decimal @default(0) @map("price_pct_delta") @db.Decimal(7, 4)
  swatchPath     String? @map("swatch_path")
  active         Boolean @default(true)
  sortOrder      Int     @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        OptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
  @@index([organizationId])
  @@map("product_options")
}

enum PriceRuleKind {
  PER_UNIT_DIMENSION
  VOLUME_DISCOUNT
  CUSTOMER_TIER
  SURCHARGE
}

/// Declarative pricing rules evaluated server-side by src/domain/pricing.
model PriceRule {
  id             String        @id @default(cuid(2))
  organizationId String        @map("organization_id")
  productId      String?       @map("product_id")
  name           String
  kind           PriceRuleKind
  priority       Int           @default(100)
  condition      Json?
  effect         Json
  validFrom      DateTime?     @map("valid_from")
  validTo        DateTime?     @map("valid_to")
  active         Boolean       @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId, active])
  @@map("price_rules")
}

// ── collab.prisma
// ─── Collaboration: polymorphic comments, tasks, notifications, files ────

model Comment {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  authorId       String    @map("author_id") @db.Uuid
  body           String
  mentions       String[]  @db.Uuid
  editedAt       DateTime? @map("edited_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId, createdAt])
  @@map("comments")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String     @id @default(cuid(2))
  organizationId String     @map("organization_id")
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?    @map("assignee_id") @db.Uuid
  dueAt          DateTime?  @map("due_at")
  entityType     String?    @map("entity_type")
  entityId       String?    @map("entity_id")
  completedAt    DateTime?  @map("completed_at")
  createdById    String     @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  version        Int        @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, entityType, entityId])
  @@map("tasks")
}

model Notification {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  recipientId    String    @map("recipient_id") @db.Uuid
  type           String
  title          String
  body           String?
  href           String?
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model Attachment {
  id             String   @id @default(cuid(2))
  organizationId String   @map("organization_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  bucket         String
  path           String
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([bucket, path])
  @@index([organizationId, entityType, entityId])
  @@map("attachments")
}

// ── crm.prisma
// ─── CRM ─────────────────────────────────────────────────────────────────

enum AccountType {
  CUSTOMER
  PROSPECT
  PARTNER
  OTHER
}

model Account {
  id              String      @id @default(cuid(2))
  organizationId  String      @map("organization_id")
  name            String
  type            AccountType @default(PROSPECT)
  industry        String?
  website         String?
  taxId           String?     @map("tax_id")
  billingAddress  Json?       @map("billing_address")
  shippingAddress Json?       @map("shipping_address")
  ownerId         String?     @map("owner_id") @db.Uuid
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(14, 2)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  archivedAt      DateTime?   @map("archived_at")
  version         Int         @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  leads        Lead[]
  quotes       Quote[]
  salesOrders  SalesOrder[]
  invoices     Invoice[]

  @@index([organizationId, name])
  @@index([organizationId, ownerId])
  @@map("accounts")
}

model Contact {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  accountId      String?   @map("account_id")
  firstName      String    @map("first_name")
  lastName       String?   @map("last_name")
  email          String?
  phone          String?
  jobTitle       String?   @map("job_title")
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  archivedAt     DateTime? @map("archived_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  leads        Lead[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, accountId])
  @@map("contacts")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  DISQUALIFIED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  EMAIL
  SOCIAL
  PAID_ADS
  PARTNER
  EVENT
  OTHER
}

model Lead {
  id              String     @id @default(cuid(2))
  organizationId  String     @map("organization_id")
  number          String
  title           String
  status          LeadStatus @default(NEW)
  source          LeadSource @default(OTHER)
  campaign        String?
  accountId       String?    @map("account_id")
  contactId       String?    @map("contact_id")
  ownerId         String?    @map("owner_id") @db.Uuid
  estimatedValue  Decimal?   @map("estimated_value") @db.Decimal(14, 2)
  aiScore         Int?       @map("ai_score")
  aiSummary       String?    @map("ai_summary")
  lostReason      String?    @map("lost_reason")
  nextFollowUpAt  DateTime?  @map("next_follow_up_at")
  firstResponseAt DateTime?  @map("first_response_at")
  convertedAt     DateTime?  @map("converted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  version         Int        @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities   Activity[]
  quotes       Quote[]

  @@unique([organizationId, number])
  @@index([organizationId, status, ownerId])
  @@index([organizationId, nextFollowUpAt])
  @@map("leads")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  NOTE
  VISIT
}

model Activity {
  id             String       @id @default(cuid(2))
  organizationId String       @map("organization_id")
  leadId         String?      @map("lead_id")
  type           ActivityType
  subject        String
  body           String?
  outcome        String?
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  durationSec    Int?         @map("duration_sec")
  actorId        String       @map("actor_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, occurredAt])
  @@map("activities")
}

// ── finance.prisma
// ─── Finance (accounts receivable, v1) ───────────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid(2))
  organizationId String        @map("organization_id")
  number         String
  status         InvoiceStatus @default(DRAFT)
  accountId      String        @map("account_id")
  salesOrderId   String?       @map("sales_order_id")
  currency       String        @db.Char(3)
  issueDate      DateTime?     @map("issue_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  version        Int           @default(0)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  invoiceId      String  @map("invoice_id")
  lineNo         Int     @map("line_no")
  description    String
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  taxRatePct     Decimal @default(0) @map("tax_rate_pct") @db.Decimal(7, 4)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@index([organizationId])
  @@map("invoice_lines")
}

// ── fulfillment.prisma
// ─── Fulfillment ─────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  PACKED
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Shipment {
  id               String         @id @default(cuid(2))
  organizationId   String         @map("organization_id")
  number           String
  salesOrderId     String         @map("sales_order_id")
  status           ShipmentStatus @default(PENDING)
  carrier          String?
  trackingRef      String?        @map("tracking_ref")
  vehicleRef       String?        @map("vehicle_ref")
  scheduledFor     DateTime?      @map("scheduled_for")
  deliveredAt      DateTime?      @map("delivered_at")
  podSignaturePath String?        @map("pod_signature_path")
  podPhotoPaths    String[]       @map("pod_photo_paths")
  podReceivedBy    String?        @map("pod_received_by")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  version          Int            @default(0)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lines        ShipmentLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status, scheduledFor])
  @@map("shipments")
}

model ShipmentLine {
  id               String  @id @default(cuid(2))
  organizationId   String  @map("organization_id")
  shipmentId       String  @map("shipment_id")
  salesOrderLineId String  @map("sales_order_line_id")
  quantity         Decimal @db.Decimal(14, 3)
  packages         Int     @default(1)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)

  @@index([organizationId, shipmentId])
  @@map("shipment_lines")
}

// ── inventory.prisma
// ─── Inventory: items, locations, ledger-based stock ─────────────────────

enum ItemType {
  RAW_MATERIAL
  COMPONENT
  FINISHED_GOOD
  CONSUMABLE
  SERVICE
}

model Item {
  id             String   @id @default(cuid(2))
  organizationId String   @map("organization_id")
  code           String
  name           String
  type           ItemType
  uom            String
  category       String?
  standardCost   Decimal  @default(0) @map("standard_cost") @db.Decimal(14, 4)
  reorderPoint   Decimal? @map("reorder_point") @db.Decimal(14, 3)
  reorderQty     Decimal? @map("reorder_qty") @db.Decimal(14, 3)
  leadTimeDays   Int      @default(0) @map("lead_time_days")
  trackLots      Boolean  @default(false) @map("track_lots")
  specs          Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product?
  stockLevels         StockLevel[]
  movements           StockMovement[]
  reservations        Reservation[]
  purchaseLines       PurchaseOrderLine[]
  bomLines            BomLine[]
  preferredSupplierId String?             @map("preferred_supplier_id")
  preferredSupplier   Supplier?           @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, type, active])
  @@map("items")
}

model Warehouse {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  code           String
  name           String
  address        Json?
  isDefault      Boolean @default(false) @map("is_default")
  active         Boolean @default(true)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  receipts     GoodsReceipt[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

/// Materialized balance per item/warehouse — maintained only by stock movements.
model StockLevel {
  organizationId String   @map("organization_id")
  itemId         String   @map("item_id")
  warehouseId    String   @map("warehouse_id")
  onHand         Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  reserved       Decimal  @default(0) @db.Decimal(14, 3)
  onHold         Decimal  @default(0) @map("on_hold") @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([itemId, warehouseId])
  @@index([organizationId])
  @@map("stock_levels")
}

enum MovementType {
  RECEIPT
  ISSUE_TO_PRODUCTION
  PRODUCTION_OUTPUT
  SHIPMENT
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING_BALANCE
  QC_HOLD
  QC_RELEASE
  SCRAP
}

/// Immutable stock ledger. Never updated or deleted — corrections are new rows.
model StockMovement {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @map("organization_id")
  itemId         String       @map("item_id")
  warehouseId    String       @map("warehouse_id")
  type           MovementType
  quantity       Decimal      @db.Decimal(14, 3)
  unitCost       Decimal?     @map("unit_cost") @db.Decimal(14, 4)
  balanceAfter   Decimal      @map("balance_after") @db.Decimal(14, 3)
  lotNumber      String?      @map("lot_number")
  referenceType  String       @map("reference_type")
  referenceId    String       @map("reference_id")
  reason         String?
  idempotencyKey String       @map("idempotency_key")
  actorId        String?      @map("actor_id") @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, itemId, occurredAt])
  @@index([organizationId, referenceType, referenceId])
  @@map("stock_movements")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model Reservation {
  id               String            @id @default(cuid(2))
  organizationId   String            @map("organization_id")
  itemId           String            @map("item_id")
  salesOrderLineId String?           @map("sales_order_line_id")
  workOrderId      String?           @map("work_order_id")
  quantity         Decimal           @db.Decimal(14, 3)
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  salesOrderLine SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: Cascade)
  workOrder      WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, itemId, status])
  @@map("reservations")
}

// ── platform.prisma
// ─── Platform: tenancy, identity, access control, audit ──────────────────

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Organization {
  id         String    @id @default(cuid(2))
  slug       String    @unique
  name       String
  legalName  String?   @map("legal_name")
  taxId      String?   @map("tax_id")
  currency   String    @default("USD") @db.Char(3)
  timezone   String    @default("UTC")
  locale     String    @default("en-US")
  plan       PlanTier  @default(FREE)
  logoPath   String?   @map("logo_path")
  /// Members must complete two-factor authentication (aal2) to open this workspace.
  requireMfa Boolean   @default(false) @map("require_mfa")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  memberships        Membership[]
  roles              Role[]
  invitations        Invitation[]
  apiKeys            ApiKey[]
  auditEvents        AuditEvent[]
  sequences          Sequence[]
  outboxEvents       OutboxEvent[]
  settings           Setting[]
  comments           Comment[]
  tasks              Task[]
  notifications      Notification[]
  attachments        Attachment[]
  accounts           Account[]
  contacts           Contact[]
  leads              Lead[]
  activities         Activity[]
  productCategories  ProductCategory[]
  products           Product[]
  optionGroups       OptionGroup[]
  productOptions     ProductOption[]
  priceRules         PriceRule[]
  quotes             Quote[]
  quoteLines         QuoteLine[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  payments           Payment[]
  items              Item[]
  warehouses         Warehouse[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  reservations       Reservation[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  workCenters        WorkCenter[]
  boms               BillOfMaterials[]
  bomLines           BomLine[]
  workOrders         WorkOrder[]
  workOrderOps       WorkOrderOperation[]
  timeLogs           TimeLog[]
  inspectionPlans    InspectionPlan[]
  inspections        Inspection[]
  nonConformances    NonConformance[]
  shipments          Shipment[]
  shipmentLines      ShipmentLine[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]

  @@map("organizations")
}

/// 1:1 with Supabase auth.users (id is the auth user's UUID).
model Profile {
  id         String   @id @db.Uuid
  email      String   @unique
  fullName   String?  @map("full_name")
  avatarPath String?  @map("avatar_path")
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("profiles")
}

model Membership {
  id             String           @id @default(cuid(2))
  organizationId String           @map("organization_id")
  profileId      String           @map("profile_id") @db.Uuid
  roleId         String           @map("role_id")
  status         MembershipStatus @default(ACTIVE)
  title          String?
  department     String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, profileId])
  @@index([profileId])
  @@map("memberships")
}

/// Global permission catalog, e.g. key = "sales.order.approve".
model Permission {
  key         String @id
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(cuid(2))
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model Invitation {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  email          String
  roleId         String    @map("role_id")
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model ApiKey {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  name           String
  prefix         String    @unique
  keyHash        String    @map("key_hash")
  scopes         String[]
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

enum ActorType {
  USER
  SYSTEM
  AI
  API_KEY
}

/// Append-only audit trail for every write.
model AuditEvent {
  id             BigInt    @id @default(autoincrement())
  organizationId String    @map("organization_id")
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id")
  approvedById   String?   @map("approved_by_id") @db.Uuid
  action         String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  changes        Json?
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Gap-free per-tenant document numbering (SO-2026-00001). Incremented with
/// UPDATE … RETURNING inside the same transaction as the document insert.
model Sequence {
  organizationId String  @map("organization_id")
  key            String
  prefix         String
  nextValue      Int     @default(1) @map("next_value")
  padding        Int     @default(5)
  resetYearly    Boolean @default(true) @map("reset_yearly")
  year           Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("sequences")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Transactional outbox: domain events for notifications, webhooks, AI jobs.
model OutboxEvent {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @map("organization_id")
  type           String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_events")
}

/// Typed key/value tenant settings (validated with zod in the app).
model Setting {
  organizationId String   @map("organization_id")
  key            String
  value          Json
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("settings")
}

// ── procurement.prisma
// ─── Procurement ─────────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(cuid(2))
  organizationId String   @map("organization_id")
  code           String
  name           String
  email          String?
  phone          String?
  taxId          String?  @map("tax_id")
  address        Json?
  paymentTerms   String?  @map("payment_terms")
  rating         Decimal? @db.Decimal(3, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  preferredFor   Item[]

  @@unique([organizationId, code])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid(2))
  organizationId String              @map("organization_id")
  number         String
  status         PurchaseOrderStatus @default(DRAFT)
  supplierId     String              @map("supplier_id")
  currency       String              @db.Char(3)
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal             @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  expectedDate   DateTime?           @map("expected_date") @db.Date
  terms          String?
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at")
  sentAt         DateTime?           @map("sent_at")
  createdById    String              @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  version        Int                 @default(0)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]

  @@unique([organizationId, number])
  @@index([organizationId, status, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(cuid(2))
  organizationId  String  @map("organization_id")
  purchaseOrderId String  @map("purchase_order_id")
  lineNo          Int     @map("line_no")
  itemId          String  @map("item_id")
  quantity        Decimal @db.Decimal(14, 3)
  unitPrice       Decimal @map("unit_price") @db.Decimal(14, 4)
  taxRatePct      Decimal @default(0) @map("tax_rate_pct") @db.Decimal(7, 4)
  qtyReceived     Decimal @default(0) @map("qty_received") @db.Decimal(14, 3)
  qtyAccepted     Decimal @default(0) @map("qty_accepted") @db.Decimal(14, 3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, lineNo])
  @@index([organizationId, itemId])
  @@map("purchase_order_lines")
}

enum ReceiptStatus {
  RECEIVED
  INSPECTING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
}

model GoodsReceipt {
  id              String        @id @default(cuid(2))
  organizationId  String        @map("organization_id")
  number          String
  purchaseOrderId String        @map("purchase_order_id")
  warehouseId     String        @map("warehouse_id")
  status          ReceiptStatus @default(RECEIVED)
  supplierDocRef  String?       @map("supplier_doc_ref")
  vehicleRef      String?       @map("vehicle_ref")
  /// [{ poLineId, qtyReceived, qtyAccepted, lotNumber }]
  lines           Json
  receivedById    String        @map("received_by_id") @db.Uuid
  receivedAt      DateTime      @default(now()) @map("received_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inspections   Inspection[]

  @@unique([organizationId, number])
  @@index([organizationId, purchaseOrderId])
  @@map("goods_receipts")
}

// ── production.prisma
// ─── Production: BOMs, routings, work orders, shop-floor time ────────────

model WorkCenter {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  code           String
  name           String
  capacityHrsDay Decimal @default(8) @map("capacity_hrs_day") @db.Decimal(6, 2)
  costPerHour    Decimal @default(0) @map("cost_per_hour") @db.Decimal(14, 2)
  sequence       Int     @default(0)
  active         Boolean @default(true)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operations   WorkOrderOperation[]

  @@unique([organizationId, code])
  @@map("work_centers")
}

enum BomStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSOLETE
}

model BillOfMaterials {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  revision       Int       @default(1)
  status         BomStatus @default(DRAFT)
  /// Routing template: [{ workCenterCode, name, stdMinutes, inspection? }]
  routing        Json?
  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines        BomLine[]
  workOrders   WorkOrder[]

  @@unique([productId, revision])
  @@index([organizationId, status])
  @@map("boms")
}

model BomLine {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  bomId          String  @map("bom_id")
  itemId         String  @map("item_id")
  quantity       Decimal @db.Decimal(14, 4)
  scrapPct       Decimal @default(0) @map("scrap_pct") @db.Decimal(7, 4)
  /// Optional formula for configurable products, e.g. "width_cm * 0.012".
  qtyFormula     String? @map("qty_formula")
  /// Only include when configuration matches (JSON-logic).
  condition      Json?
  notes          String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bom          BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item         Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([organizationId, bomId])
  @@map("bom_lines")
}

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id               String          @id @default(cuid(2))
  organizationId   String          @map("organization_id")
  number           String
  status           WorkOrderStatus @default(PLANNED)
  priority         Priority        @default(MEDIUM)
  salesOrderLineId String?         @map("sales_order_line_id")
  bomId            String          @map("bom_id")
  quantity         Decimal         @db.Decimal(14, 3)
  qtyCompleted     Decimal         @default(0) @map("qty_completed") @db.Decimal(14, 3)
  plannedStart     DateTime?       @map("planned_start")
  plannedEnd       DateTime?       @map("planned_end")
  actualStart      DateTime?       @map("actual_start")
  actualEnd        DateTime?       @map("actual_end")
  holdReason       String?         @map("hold_reason")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  version          Int             @default(0)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine?      @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  bom            BillOfMaterials      @relation(fields: [bomId], references: [id], onDelete: Restrict)
  operations     WorkOrderOperation[]
  reservations   Reservation[]
  inspections    Inspection[]

  @@unique([organizationId, number])
  @@index([organizationId, status, plannedEnd])
  @@map("work_orders")
}

enum OperationStatus {
  PENDING
  READY
  IN_PROGRESS
  PAUSED
  DONE
  REWORK
}

model WorkOrderOperation {
  id                 String          @id @default(cuid(2))
  organizationId     String          @map("organization_id")
  workOrderId        String          @map("work_order_id")
  sequence           Int
  name               String
  workCenterId       String          @map("work_center_id")
  status             OperationStatus @default(PENDING)
  stdMinutes         Int             @default(0) @map("std_minutes")
  actualMinutes      Int             @default(0) @map("actual_minutes")
  assigneeId         String?         @map("assignee_id") @db.Uuid
  requiresInspection Boolean         @default(false) @map("requires_inspection")
  startedAt          DateTime?       @map("started_at")
  completedAt        DateTime?       @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workCenter   WorkCenter   @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  timeLogs     TimeLog[]

  @@unique([workOrderId, sequence])
  @@index([organizationId, workCenterId, status])
  @@map("work_order_operations")
}

model TimeLog {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  operationId    String    @map("operation_id")
  workerId       String    @map("worker_id") @db.Uuid
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")
  source         String    @default("kiosk")
  note           String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operation    WorkOrderOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([organizationId, workerId, startedAt])
  @@index([operationId])
  @@map("time_logs")
}

// ── quality.prisma
// ─── Quality ─────────────────────────────────────────────────────────────

enum InspectionStage {
  INBOUND
  IN_PROCESS
  FINAL
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

model InspectionPlan {
  id             String          @id @default(cuid(2))
  organizationId String          @map("organization_id")
  name           String
  stage          InspectionStage
  appliesTo      String?         @map("applies_to")
  /// [{ code, label, type: "check"|"measure", min?, max?, unit?, critical }]
  checklist      Json
  active         Boolean         @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspections  Inspection[]

  @@index([organizationId, stage])
  @@map("inspection_plans")
}

model Inspection {
  id             String           @id @default(cuid(2))
  organizationId String           @map("organization_id")
  number         String
  stage          InspectionStage
  planId         String           @map("plan_id")
  result         InspectionResult @default(PENDING)
  goodsReceiptId String?          @map("goods_receipt_id")
  workOrderId    String?          @map("work_order_id")
  /// [{ code, value, pass, note, photoPath? }]
  responses      Json?
  inspectorId    String?          @map("inspector_id") @db.Uuid
  inspectedAt    DateTime?        @map("inspected_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan            InspectionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  goodsReceipt    GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  nonConformances NonConformance[]

  @@unique([organizationId, number])
  @@index([organizationId, stage, result])
  @@map("inspections")
}

enum NcrDisposition {
  PENDING
  REWORK
  USE_AS_IS
  RETURN_TO_SUPPLIER
  SCRAP
}

model NonConformance {
  id             String         @id @default(cuid(2))
  organizationId String         @map("organization_id")
  number         String
  inspectionId   String         @map("inspection_id")
  description    String
  severity       Priority       @default(MEDIUM)
  disposition    NcrDisposition @default(PENDING)
  rootCause      String?        @map("root_cause")
  ownerId        String?        @map("owner_id") @db.Uuid
  closedAt       DateTime?      @map("closed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId, disposition])
  @@map("non_conformances")
}

// ── sales.prisma
// ─── Sales: quotes, orders, payments ─────────────────────────────────────

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String      @id @default(cuid(2))
  organizationId String      @map("organization_id")
  number         String
  status         QuoteStatus @default(DRAFT)
  accountId      String      @map("account_id")
  leadId         String?     @map("lead_id")
  ownerId        String      @map("owner_id") @db.Uuid
  currency       String      @db.Char(3)
  subtotal       Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal     @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal       Decimal     @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  validUntil     DateTime?   @map("valid_until")
  notes          String?
  approvedById   String?     @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?   @map("approved_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  version        Int         @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  lines        QuoteLine[]
  salesOrder   SalesOrder?

  @@unique([organizationId, number])
  @@index([organizationId, status, ownerId])
  @@map("quotes")
}

model QuoteLine {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  quoteId        String  @map("quote_id")
  lineNo         Int     @map("line_no")
  productId      String  @map("product_id")
  description    String
  /// Selected configuration: { [optionGroupCode]: value }
  configuration  Json?
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  discountPct    Decimal @default(0) @map("discount_pct") @db.Decimal(7, 4)
  taxRatePct     Decimal @default(0) @map("tax_rate_pct") @db.Decimal(7, 4)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)
  /// Server pricing breakdown for transparency / audit.
  priceBreakdown Json?   @map("price_breakdown")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quoteId, lineNo])
  @@index([organizationId])
  @@map("quote_lines")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  CLOSED
  CANCELLED
}

model SalesOrder {
  id              String           @id @default(cuid(2))
  organizationId  String           @map("organization_id")
  number          String
  status          SalesOrderStatus @default(DRAFT)
  accountId       String           @map("account_id")
  quoteId         String?          @unique @map("quote_id")
  ownerId         String           @map("owner_id") @db.Uuid
  currency        String           @db.Char(3)
  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal          @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal        Decimal          @default(0) @map("tax_total") @db.Decimal(14, 2)
  total           Decimal          @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal          @default(0) @map("amount_paid") @db.Decimal(14, 2)
  promisedDate    DateTime?        @map("promised_date") @db.Date
  shippingAddress Json?            @map("shipping_address")
  customerPoRef   String?          @map("customer_po_ref")
  confirmedAt     DateTime?        @map("confirmed_at")
  cancelledReason String?          @map("cancelled_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  version         Int              @default(0)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quote        Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  lines        SalesOrderLine[]
  payments     Payment[]
  shipments    Shipment[]
  invoices     Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status, promisedDate])
  @@index([organizationId, accountId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id             String  @id @default(cuid(2))
  organizationId String  @map("organization_id")
  salesOrderId   String  @map("sales_order_id")
  lineNo         Int     @map("line_no")
  productId      String  @map("product_id")
  description    String
  configuration  Json?
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  discountPct    Decimal @default(0) @map("discount_pct") @db.Decimal(7, 4)
  taxRatePct     Decimal @default(0) @map("tax_rate_pct") @db.Decimal(7, 4)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)
  qtyShipped     Decimal @default(0) @map("qty_shipped") @db.Decimal(14, 3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  workOrders    WorkOrder[]
  reservations  Reservation[]
  shipmentLines ShipmentLine[]

  @@unique([salesOrderId, lineNo])
  @@index([organizationId])
  @@map("sales_order_lines")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  UPI
  OTHER
}

model Payment {
  id             String        @id @default(cuid(2))
  organizationId String        @map("organization_id")
  salesOrderId   String?       @map("sales_order_id")
  invoiceId      String?       @map("invoice_id")
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  receivedAt     DateTime      @map("received_at")
  /// Client-supplied key; retries of the same payment are no-ops.
  idempotencyKey String        @map("idempotency_key")
  recordedById   String        @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receivedAt])
  @@map("payments")
}
