// ─── Platform: tenancy, identity, access control, audit ──────────────────

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Organization {
  id         String    @id @default(cuid(2))
  slug       String    @unique
  name       String
  legalName  String?   @map("legal_name")
  taxId      String?   @map("tax_id")
  currency   String    @default("USD") @db.Char(3)
  timezone   String    @default("UTC")
  locale     String    @default("en-US")
  plan       PlanTier  @default(FREE)
  logoPath   String?   @map("logo_path")
  /// Members must complete two-factor authentication (aal2) to open this workspace.
  requireMfa Boolean   @default(false) @map("require_mfa")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  memberships        Membership[]
  roles              Role[]
  invitations        Invitation[]
  apiKeys            ApiKey[]
  auditEvents        AuditEvent[]
  sequences          Sequence[]
  outboxEvents       OutboxEvent[]
  settings           Setting[]
  comments           Comment[]
  tasks              Task[]
  notifications      Notification[]
  attachments        Attachment[]
  accounts           Account[]
  contacts           Contact[]
  leads              Lead[]
  activities         Activity[]
  productCategories  ProductCategory[]
  products           Product[]
  optionGroups       OptionGroup[]
  productOptions     ProductOption[]
  priceRules         PriceRule[]
  quotes             Quote[]
  quoteLines         QuoteLine[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  payments           Payment[]
  items              Item[]
  warehouses         Warehouse[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  reservations       Reservation[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  workCenters        WorkCenter[]
  boms               BillOfMaterials[]
  bomLines           BomLine[]
  workOrders         WorkOrder[]
  workOrderOps       WorkOrderOperation[]
  timeLogs           TimeLog[]
  inspectionPlans    InspectionPlan[]
  inspections        Inspection[]
  nonConformances    NonConformance[]
  shipments          Shipment[]
  shipmentLines      ShipmentLine[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]

  @@map("organizations")
}

/// 1:1 with Supabase auth.users (id is the auth user's UUID).
model Profile {
  id         String   @id @db.Uuid
  email      String   @unique
  fullName   String?  @map("full_name")
  avatarPath String?  @map("avatar_path")
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("profiles")
}

model Membership {
  id             String           @id @default(cuid(2))
  organizationId String           @map("organization_id")
  profileId      String           @map("profile_id") @db.Uuid
  roleId         String           @map("role_id")
  status         MembershipStatus @default(ACTIVE)
  title          String?
  department     String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, profileId])
  @@index([profileId])
  @@map("memberships")
}

/// Global permission catalog, e.g. key = "sales.order.approve".
model Permission {
  key         String @id
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(cuid(2))
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model Invitation {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  email          String
  roleId         String    @map("role_id")
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model ApiKey {
  id             String    @id @default(cuid(2))
  organizationId String    @map("organization_id")
  name           String
  prefix         String    @unique
  keyHash        String    @map("key_hash")
  scopes         String[]
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

enum ActorType {
  USER
  SYSTEM
  AI
  API_KEY
}

/// Append-only audit trail for every write.
model AuditEvent {
  id             BigInt    @id @default(autoincrement())
  organizationId String    @map("organization_id")
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id")
  approvedById   String?   @map("approved_by_id") @db.Uuid
  action         String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  changes        Json?
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Gap-free per-tenant document numbering (SO-2026-00001). Incremented with
/// UPDATE … RETURNING inside the same transaction as the document insert.
model Sequence {
  organizationId String  @map("organization_id")
  key            String
  prefix         String
  nextValue      Int     @default(1) @map("next_value")
  padding        Int     @default(5)
  resetYearly    Boolean @default(true) @map("reset_yearly")
  year           Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("sequences")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Transactional outbox: domain events for notifications, webhooks, AI jobs.
model OutboxEvent {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @map("organization_id")
  type           String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_events")
}

/// Typed key/value tenant settings (validated with zod in the app).
model Setting {
  organizationId String   @map("organization_id")
  key            String
  value          Json
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("settings")
}
