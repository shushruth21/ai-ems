{
  "name": "ai-ems",
  "version": "0.2.0",
  "private": true,
  "description": "AI-Powered Enterprise Management System \u2014 monorepo root",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10.20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ai-ems/web",
    "build": "turbo run build",
    "start": "pnpm --filter @ai-ems/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:integration": "pnpm --filter @ai-ems/db test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run typecheck lint test && prettier --check .",
    "db:generate": "pnpm --filter @ai-ems/db db:generate",
    "db:validate": "pnpm --filter @ai-ems/db db:validate",
    "db:migrate": "pnpm --filter @ai-ems/db db:migrate",
    "db:deploy": "pnpm --filter @ai-ems/db db:deploy",
    "db:seed": "pnpm --filter @ai-ems/db db:seed",
    "db:studio": "pnpm --filter @ai-ems/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "doctor": "node tools/developer/doctor.mjs",
    "postinstall": "pnpm --filter @ai-ems/db db:generate || echo 'Prisma client not generated \u2014 run pnpm db:generate'",
    "dev:local": "node tools/developer/dev-local.mjs",
    "db:sql": "pnpm --filter @ai-ems/db db:sql",
    "db:deploy:wasm": "pnpm --filter @ai-ems/db db:deploy:wasm",
    "db:migrate:wasm": "pnpm --filter @ai-ems/db db:migrate:wasm"
  },
  "devDependencies": {
    "@ai-ems/eslint-config": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "eslint": "catalog:",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13",
    "typescript": "catalog:"
  },
  "type": "module"
}
