{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "PLAYWRIGHT_CHROMIUM_PATH",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "cache": true,
      "env": ["DATABASE_URL", "SUPABASE_SECRET_KEY"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!tests/**"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "ENABLE_UI_PREVIEW", "DATABASE_URL", "SUPABASE_SECRET_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
