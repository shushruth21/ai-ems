# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI EMS"

# ─── Supabase (Project Settings → API) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── Database (Project Settings → Database → Connection string) ────────
# Pooled (Supavisor, transaction mode) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (session mode) — used by Prisma Migrate.
DIRECT_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── Email (invitations, notifications) ────────────────────────────────
# log = print to the server console (development default); none = don't send
# (production default until an email provider is configured);
# smtp = any SMTP server (SMTP_URL); resend = Resend's API (RESEND_API_KEY).
# MAIL_TRANSPORT=log
MAIL_FROM="AI EMS <no-reply@ai-ems.local>"
# SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=

# ─── Outbox worker (tools/worker) ──────────────────────────────────────
# WORKER_POLL_MS=2000
# WORKER_BATCH_SIZE=20
# Serves GET /healthz for container probes when set.
# WORKER_HEALTH_PORT=4000

# ─── Authentication ─────────────────────────────────────────────────────
# memory (default in dev) | postgres (default in production)
# AUTH_RATE_LIMIT_STORE=memory
AUTH_RATE_LIMIT_ENABLED=true
# HMAC key for hashing emails in audit/rate-limit rows (32+ random chars).
# Falls back to SUPABASE_SECRET_KEY when unset.
# AUTH_IDENTITY_SECRET=
FEATURE_SIGN_UP=true
FEATURE_MAGIC_LINK=true
FEATURE_MFA_TOTP=true
# Enable after configuring the provider in Supabase (Authentication → Providers).
FEATURE_OAUTH_GOOGLE=false
FEATURE_OAUTH_MICROSOFT=false

# ─── AI (Phase 21) ──────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=

# ─── UI preview sandbox (/preview, sample data, no login) ─────────────
# Defaults: on in development, off in production.
# ENABLE_UI_PREVIEW=false

# ─── Observability (optional) ──────────────────────────────────────────
LOG_LEVEL=info
