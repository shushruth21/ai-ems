NEXT_PUBLIC_APP_URL=https://staging.ai-ems.example
NEXT_PUBLIC_APP_NAME="AI EMS (staging)"
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<set in Vercel>
SUPABASE_SECRET_KEY=<secret — set in Vercel/GitHub>
DATABASE_URL=<pooled :6543 — secret>
DIRECT_URL=<session :5432 — secret, GitHub only>
ENABLE_UI_PREVIEW=true
LOG_LEVEL=debug
AI_PROVIDER=none
MAIL_TRANSPORT=none
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_STORE=postgres
AUTH_IDENTITY_SECRET=<secret — 32+ random chars>
FEATURE_MFA_TOTP=true
FEATURE_SIGN_UP=true
FEATURE_MAGIC_LINK=true
FEATURE_OAUTH_GOOGLE=true
FEATURE_OAUTH_MICROSOFT=false
